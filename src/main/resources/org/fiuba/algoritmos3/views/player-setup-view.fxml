<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="500.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fiuba.algoritmos3.controller.PlayerSetupController">
    <children>
        <HBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER">
                    <children>
                        <Label fx:id="playerNameTitle" alignment="CENTER" contentDisplay="CENTER" prefHeight="42.0"
                               prefWidth="289.0" style="-fx-alignment: center; -fx-font-family: 'Roboto Black';"
                               text="Jugador #" textAlignment="CENTER">
                            <font>
                                <Font size="18.0"/>
                            </font>
                        </Label>
                        <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="42.0" prefWidth="289.0"
                               style="-fx-alignment: center; -fx-font-family: 'Roboto Black'"
                               text="1. Escribe tu nombre:" textAlignment="CENTER"/>
                        <TextField fx:id="playerNameText" alignment="CENTER" onKeyTyped="#onKeyTyped" prefHeight="25.0"
                                   prefWidth="227.0" promptText="Hasta 50 caracteres"/>
                        <Button fx:id="nextButton" alignment="CENTER" contentDisplay="CENTER" defaultButton="true"
                                disable="true" mnemonicParsing="false" onMouseClicked="#onNextClick" text="Siguiente"
                                textAlignment="CENTER">
                            <VBox.margin>
                                <Insets top="10.0"/>
                            </VBox.margin>
                        </Button>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>
