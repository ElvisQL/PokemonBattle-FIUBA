            </AnchorPane>
            <GridPane fx:id="skillsGrid" alignment="CENTER_RIGHT" prefHeight="162.0" prefWidth="413.0" style="-fx-background-color: #7d7db9; -fx-border-color: #adadad; -fx-border-width: 7; -fx-border-radius: 5; -fx-background-radius: 10;">
