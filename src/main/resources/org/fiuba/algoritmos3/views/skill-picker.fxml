        <HBox alignment="CENTER" prefHeight="168.0" prefWidth="768.0" style="-fx-background-color: #2a2e2d; -fx-border-color: #2a2e2d; -fx-border-width: 3;">
            <AnchorPane prefHeight="162.0" prefWidth="341.0" style="-fx-background-color: #f3f3f3; -fx-border-color: #7d7db9; -fx-border-width: 7; -fx-border-radius: 5; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
