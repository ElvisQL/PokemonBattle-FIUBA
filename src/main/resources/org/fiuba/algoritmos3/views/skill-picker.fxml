<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.fiuba.algoritmos3.view.*?>

<?import org.fiuba.algoritmos3.view.component.BaseButton?>
<AnchorPane prefHeight="768.0" prefWidth="768.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fiuba.algoritmos3.controller.ChooseGameMoveController">
    <Pane prefHeight="600" prefWidth="768">
