<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<fx:root alignment="CENTER" fillHeight="false" type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ImageView fx:id="pokemonImageView" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" scaleX="-1.0" smooth="false">
            <image>
                <Image url="@../../images/pokemon/squirtle.png" />
            </image>
        </ImageView>
        <VBox fx:id="statsBox" alignment="CENTER" prefHeight="91.0" prefWidth="263.0" style="-fx-background-color: #fdfddb; -fx-border-color: #2a3d18; -fx-border-width: 5; -fx-border-radius: 5;">
            <children>
            <AnchorPane prefHeight="0.0" prefWidth="0.0" VBox.vgrow="NEVER">
               <children>
                      <HBox alignment="CENTER_LEFT" layoutY="-2.0" prefHeight="32.0" prefWidth="128.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
                          <children>
                              <Label fx:id="pokemonName" text="Squirtle">
                                  <HBox.margin>
                                      <Insets right="10.0" />
                                  </HBox.margin>
                                  <font>
                                      <Font size="14.0" />
                                  </font>
                              </Label>
                              <ImageView fx:id="pokemonTypeImageView" fitHeight="24.0" fitWidth="64.0" pickOnBounds="true" preserveRatio="true">
                                  <image>
                                      <Image url="@../../images/pokemon-type/water.png" requestedWidth="64" requestedHeight="24" />
                                  </image>
                              </ImageView>
                          </children>
                      </HBox>
                  <HBox alignment="CENTER_RIGHT" layoutX="201.0" layoutY="12.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                              <Label fx:id="pokemonLevel1" alignment="CENTER_RIGHT" contentDisplay="RIGHT" text="Lvl." textAlignment="RIGHT">
                                  <font>
                                      <Font size="14.0" />
                                  </font>
                              </Label>
                              <Label fx:id="pokemonLevel" alignment="CENTER_RIGHT" contentDisplay="RIGHT" text="12" textAlignment="RIGHT">
                                  <font>
                                      <Font size="14.0" />
                                  </font>
                              </Label>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Label text="HP:">
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </Label>
                        <ProgressBar fx:id="healthBar" prefWidth="200.0" progress="0.43" style="-fx-accent: #65ea9f; -fx-text-box-border: transparent; -fx-control-inner-background: transparent; -fx-background-radius: 0; -fx-border-radius: 0; -fx-background-color: transparent;" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </children>
</fx:root>
