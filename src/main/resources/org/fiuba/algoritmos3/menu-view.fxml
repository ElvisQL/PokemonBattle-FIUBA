<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="687.0" prefWidth="744.0" style="-fx-background-color: #fefefe;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.fiuba.algoritmos3.MenuController">

    <top>
        <HBox alignment="CENTER" prefHeight="173.0" prefWidth="744.0" spacing="10.0">
            <children>
                <ImageView fitHeight="97.0" fitWidth="347.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/pokelogo.png" />
                    </image></ImageView>
            </children>
        </HBox>
    </top>


    <center>
        <VBox alignment="CENTER" prefHeight="371.0" prefWidth="800.0" spacing="10.0" style="-fx-spacing: 15.0;">
            <Button prefHeight="25.0" prefWidth="134.0" style="-fx-border-color: #3b5ca7;" text="Comenzar Juego" onAction="#onClickOnStartGame"/>
            <Button prefHeight="25.0" prefWidth="135.0" style="-fx-border-color: #3b5ca7;" styleClass="menuButton" text="Ver top 10?" />
            <Button prefHeight="25.0" prefWidth="136.0" style="-fx-border-color: #3b5ca7;" text="Salir" />
        </VBox>
    </center>


    <bottom>
        <VBox alignment="CENTER" spacing="10.0">
            <Pane prefHeight="336.0" prefWidth="744.0">
                <children>

                    <Button layoutX="673.0" layoutY="290.0" onAction="#onMuteButtonClick" text="Mute" />
                    <ImageView fitHeight="195.0" fitWidth="381.0" layoutX="231.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@images/giphy.gif" />
                        </image>
                    </ImageView>
                </children>
            </Pane>
        </VBox>
    </bottom>

</BorderPane>
